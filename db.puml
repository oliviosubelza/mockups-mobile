@startuml

hide circle

skinparam class {
    BackgroundColor White
    ArrowColor #2C3E50
    BorderColor #34495E
}
skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
}

title DB_LOGISTICS

package "(Snapshots, Cache, Datos externos)" #FDEDEC {
    entity "sales_order" as ext_sales <<MS Ventas - SAP>> {
        * id : <<PK>>
        --
        Ordenes lista para despachar
    }

    entity "sales_order_item" as ext_sales_item <<MS Ventas - SAP>> {
        * id : <<PK>>
        --
        sales_order_split_id : <<FK>>
        product_id : Number
        requested_qty : Decimal
        confirmed_qty : Decimal
    }

    ext_sales "1" -- "1..*" ext_sales_item : tiene >

    entity "product_snapshot" as snap_product <<SAP - Cache Local>> {
        * product_id : Number
        --
        weight : Decimal
        volume : Decimal
    }

    entity "delivery_points" as snap_delivery_point <<SAP - Cache Local>> {
        * delivery_point_id : Number
        --
        owner_id : Number
        owner_name : String
        latitude : Decimal
        longitude : Decimal
        contact_name : String
        contact_phone : String
        address_text : String
    }
    entity "warehouse_snapshot" as snap_warehouse <<SAP - Almacen>> {
        * warehouse_id : Number
        --
        zone_id : Number
        status : String
        last_sync_at : Timestamp
    }
}

package "Proyecciones" #F8F9F9 {
    entity "candidate_order" as candidate_order {
        * id : <<PK>>
        --
        dispatch_delivery_point_id : <<FK>>
        sales_order_id : Number
        document_id : Number
        distributor_id : Number
        ' -delivery_window_start : Time
        ' -delivery_window_end : Time
        total_weight_kg : Decimal
        total_volume_m3 : Decimal
        -type_order: String
        is_included: Boolean
        ' priority : Integer
        ' status : String
        ' notes : Text

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null

        - refund_order_id : Number
        - transfer_id : Number
    }
}

package "Despachos (Draft -> Approved)" #EAF2F8 {

    entity "trucks" as truck_master <<Sincronizar con SAP>> {
        * id : <<PK>>
        --
        distributor_id: <<FK>>
        code: String
        plate : String
        capacity_weight : Decimal
        capacity_volume : Decimal
        status : String
        truck_type : String
        is_refrigerated : Boolean
        ' is_refrigerated_available : Boolean

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "distributors" as distributor_master {
        * id : <<PK>>
        --
        department_id : Number<<FK>>
        name: String
        latitude: Decimal,
        longitude: Decimal,

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
        active_flag : Boolean
    }

    entity "sale_channel_restrictions" as sale_channel_restrictions  {
        * id : <<PK>>
        --
        name: String
        description: String
        distributor_id : Number<<FK>>
        sale_channel_id : Number
        cut_off_time : Time

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "zones" as zone_master {
        * id : <<PK>>
        --
        department_id : Number<<FK>>
        city_id : Number<<FK>>
        name: String
        polygon_geojson : JsonB

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
        active_flag : Boolean
    }

    entity "plan_status" as planStatus {
        * id : <<PK>>
        --
        name: String
        description: String

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "dispatch_plans" as plan {
        * id : <<PK>>
        --

        plan_status_id : <<FK>>
        distributor_id : Number <<FK>>
        ' city_id : Number
        plan_date : Date
        ' optimization_status : String
        planned_order_count : Integer
        planned_truck_count : Integer
        -employee_id : Integer

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "planning_truck" as truck {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK>>
        truck_id : Number <<FK>>
        assigned_weight_kg : Decimal
        assigned_volume_m3 : Decimal
        ' status : String <<DISPONIBLE, MANTENIMIENTO>>

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null

        -is_included_in_routing: boolean <<si el camion esta incluido en una ruta>>
    }

    entity "dispatch_delivery_points" as plan_order {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK>>
        delivery_point_id : Number
        sale_channel_id: Integer
        zone_id: Integer<<FK | NULL>>
        ' planned_sequence : Integer
        priority : Integer
        ' notes : Text
        -owner_id : Number
        -owner_name : String
        -warehouse_destination_id : Number

        -delivery_window_start : Time
        -delivery_window_end : Time
        -total_weight_kg : Decimal
        -total_volume_m3 : Decimal
        -total_neto : Decimal
        <<UNIFICACION DE PUNTOS DE ENTREGAS>>
        -forced_planning_truck_id: <<FK | NULL>>

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }
}

package "Rutas y Asignación" #E9F7EF {
    entity "routes" as routes {
        * id : <<PK>>
        --
        planning_truck_id : Number <<FK | NULL>>
        dispatch_plan_id : Number <<FK | NULL>>
        employee_id : Number <<FK>>
        -driver_employee_id : Number || NULL
        -name_driver_employee : String || NULL
        -helper_employee_id : Number || NULL
        -name_helper_employee : String || NULL
        engine : String
        executed_at : Timestamp
        name : String
        eta_total_distance_m : Decimal
        eta_total_time_s : Decimal
        score : Decimal
        - total_cost: Decimal
        - is_selected: boolean<<default false>>
        - encode_polyline: String

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "route_delivery_points" as opt_order {
        * id : <<PK>>
        --
        route_id : <<FK>>
        dispatch_delivery_point_id : <<FK>>
        sequence : Integer
        estimated_distance_m : Decimal<<meters>>
        estimated_travel_s : Decimal<<seconds>>
        - is_active: Boolean
        - estimated_total_cost: Decimal<<routeTotalCost>>

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }
}

package "Carga en Camion (Ejecución Física)" #FEF9E7 {

    entity "transport_orders" as exec_order {
        * id : <<PK>>
        --
        dispatch_plan_id : <<FK | Null>>
        distributor_id: <<FK>>
        code : Number
        route_id : Number <<FK>>
        checked_by : String | NULL
        assigned_weight_kg : Decimal
        assigned_volume_m3 : Decimal
        status : String (CREATED, ENROUTE, ARRIVED, etc.)

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "transport_order_histories" as transp_ord_hist {
        * id : <<PK>>
        --
        transport_order_id : <<FK>>
        status : String (CREATED, ENROUTE, ARRIVED, etc.)
        description : Text

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "transport_order_sales" as transport_order_sale {
        * id : <<PK>>
        --
        transport_order_id : <<FK>>
        sale_order_id : Number
        document_id : Number
        total_weight_kg : Decimal
        total_volume_m3 : Decimal

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "transport_order_sale_items" as transport_order_sale_item {
        * id : <<PK>>
        --
        transport_order_sale_id : <<FK>>
        product_id : Number
        quantity_min : Number

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "truck_inventories" as inventory {
        * id : <<PK>>
        --
        truck_id : <<FK>>
        transport_order_id : <<FK>>
        product_id : Number
        loaded_qty : Decimal
        expected_qty : Decimal
        variance_qty : Decimal
        -status : String <<PENDING, MATCH, APPROVED>>
        -verified_supervisor_id: Number
        ' as_of_at : Timestamp

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }
}

package "Ultima Milla (Entregas)" #E8F8F5 {
    entity "delivery_orders" as delivery {
        * id : <<PK>>
        --
        transport_order_id : <<FK>>
        ' FK a la Orden de Transporte contenedora. Define a qué viaje pertenece esta parada.
        dispatch_delivery_point_id : <<FK>>
        ' FK al punto de entrega unificado. Evita duplicar delivery_point_id, dueño y ventanas horarias.
        executed_sequence : Integer
        delivery_result_code : String <<resultado final EXITOSO, RECHAZO_PARCIAL,NO_CONTACTADO >>
        ' Código de resultado final (ej: EXITOSO, RECHAZO_TOTAL, RECHAZO_PARCIAL, NO_CONTACTADO).
        status : String <<Estado operativo de la parada,PENDING, ENROUTE, ARRIVED, DELIVERED>>
        ' Estado operativo de la parada (PENDING, ENROUTE, ARRIVED, DELIVERED, REJECTED).
        arrival_latitude : Decimal <<Latitud GPS exacta capturada cuando el chofer presiona "Llegué al cliente">>
        ' Latitud GPS exacta capturada cuando el chofer presiona "Llegué al cliente".
        arrival_longitude : Decimal <<Longitud GPS exacta capturada cuando el chofer presiona "Llegué al cliente">>
        ' Longitud GPS exacta capturada cuando el chofer presiona "Llegué al cliente".
        arrived_at : Timestamp <<Fecha y hora exacta de entrada al cliente>>
        ' Fecha y hora exacta de entrada a la geocerca / llegada al cliente.
        delivered_at : Timestamp | Null <<Fecha y hora exacta en que se finalizo>>
        ' Fecha y hora exacta en que se finalizó y firmó la entrega.

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "delivery_order_items" as delivery_item {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        sales_order_id : Number <<FK venta comercial en SAP>>
        ' FK a la orden de venta comercial en SAP/CRM. Mantiene la trazabilidad 1 a 1 con la factura/pedido original.
        product_id : Number <<FK>>
        ' FK al producto entregado.
        planned_qty : Decimal <<Cantidad fisica programada a entregar>>
        ' Cantidad física programada a entregar en unidad mínima.
        delivered_qty : Decimal <<Cantidad física entregada>>
        ' Cantidad física efectivamente aceptada y entregada al cliente (unidad mínima).
        returned_qty : Decimal <<Cantidad física devuelta/rechazada>>
        ' Cantidad física devuelta/rechazada por el cliente en rampa de descarga.
        unit_price_snapshot : Decimal <<Snapshot del precio unitario>>
        ' Snapshot del precio unitario original para recalcular el cobro (COD) si hay rechazo parcial.
        rejection_reason_code : String | Null <<Motivo específico si returned_qty > 0 (ej:VENCIDO, PRECIO_INCORRECTO).>>
        ' Motivo específico si returned_qty > 0 (ej: PRODUCTO_DANIADO, VENCIDO, PRECIO_INCORRECTO).
        item_status : String <<PENDING, DELIVERED, PARTIALLY_REJECTED, REJECTED>>
        ' Estado del ítem (PENDING, DELIVERED, PARTIALLY_REJECTED, REJECTED).
        notes : Text << Observaciones específicas escritas por el chofer sobre este producto>>
        ' Observaciones específicas escritas por el chofer sobre este producto.

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "proof_of_delivery" as pod {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        ' FK a la entrega respaldada (relación 1 a 1).
        receiver_name : String <<Nombre completo de la persona que recibe>>
        ' Nombre completo de la persona que recibe físicamente la carga.
        receiver_document : String <<Número de CI/DNI de la persona que firma la conformidad>>
        ' Número de CI/DNI de la persona que firma la conformidad.
        signature_url : String | Null <<firma digital capturada>>
        ' URL o trazado en Base64 de la firma digital capturada en la App Móvil.
        photo_url : String | Null
        gps_lat : Decimal <<Latitud GPS exacta donde se capturó la evidencia>>
        ' Latitud GPS exacta donde se capturó la evidencia (para auditar vs coordenadas del cliente).
        gps_lon : Decimal <<Longitud GPS exacta donde se capturó la evidencia>>
        ' Longitud GPS exacta donde se capturó la evidencia.
        is_offline_captured : Boolean <<si la evidencia fue tomada sin conexión a internet>>
        ' Banderilla (true/false) que indica si la evidencia fue tomada sin conexión a internet.
        pod_status : String <<Estado del comprobante CAPTURED, UPLOADED, APPROVED>>
        ' Estado del comprobante (CAPTURED, UPLOADED, APPROVED).
        device_id : Number <<Identificador del dispositivo móvil>>
        ' Identificador del dispositivo móvil registrado.
        captured_at : Timestamp
        ' Fecha y hora real de captura en el dispositivo del chofer.
        uploaded_at : Timestamp | Null
        ' Fecha y hora en que la evidencia se sincronizó con el servidor.
        notes : Text <<Notas adicionales sobre la recepción>>
        ' Notas adicionales sobre la recepción.

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "delivery_incidents" as incident {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        ' FK a la entrega donde ocurrió el evento no deseado.
        product_id : Number | Null <<FK>>
        ' FK opcional al producto específico si la incidencia es puntual (ej: 1 caja rota) o NULL si es general.
        incident_code : String
        ' Código estandarizado de la incidencia (ej: CLIENTE_CERRADO, ZONA_INACCESIBLE, DANIADO).
        incident_type : String
        ' Categoría del problema (LOGISTICO, PRODUCTO, COMERCIAL, CLIENTE).
        severity : String
        ' Nivel de severidad (BAJA, MEDIA, ALTA, CRITICA).
        description : Text
        ' Explicación detallada narrada por el chofer.
        photo_url : String | Null
        ' URL de la foto tomada como evidencia física del problema.
        requires_return : Boolean <<Indica si la incidencia exige que el producto vuelva fisicamente>>
        ' Indica si la incidencia exige que el producto vuelva físicamente al almacén.
        resolution_status : String
        ' Estado de resolución por el supervisor (PENDING, APPROVED, OVERRIDDEN).
        resolved_at : Timestamp | Null
        ' Fecha y hora en que el supervisor resolvió la incidencia.

        created_by : String
        ' Identificador/Usuario que reportó la incidencia (Estandarizado a String).
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }

    entity "delivery_order_histories" as delivery_history {
        * id : <<PK>>
        --
        delivery_order_id : <<FK>>
        ' FK a la entrega registrada.
        status : String <<CREATED, ENROUTE, ARRIVED, DELIVERED, REJECTED, INCIDENT>>
        ' Estado transicionado (CREATED, ENROUTE, ARRIVED, DELIVERED, REJECTED, INCIDENT).
        reason : Text
        ' Razón o descripción del cambio de estado.
        captured_at : Timestamp
        ' Timestamp de ocurrencia en el móvil (para sincronización offline en orden cronológico real).

        created_by : String
        updated_by : String
        created_at : Timestamp
        updated_at : Timestamp
        deleted_at : Timestamp | Null
    }
}

distributor_master "1" -- "1..*"  sale_channel_restrictions: contiene restricciones >
planStatus "1" -- "1..*" plan: tiene >
distributor_master "1" -- "1..*" plan: tiene >
plan "1" -- "0..*" truck : asigna >
plan "1" -- "1..*" plan_order : contiene paradas >
plan_order "1" -- "0..*" candidate_order : "agrega" >
zone_master "1" -- "0..*" plan_order : "agrega" >

snap_warehouse ..> plan : "valida almacén"
snap_delivery_point ..> plan_order : "provee GPS"
truck_master "1" .. "0..*" truck : "copia capacidad" >

plan "1" -- "0..*" routes : ejecuta >
routes "1" -- "0..*" opt_order : resultados >
routes "1" -- "0..*" exec_order: contiene >
plan_order "1" .. "0..*" opt_order : "optimizado en" >
truck "1" .. "0..*" opt_order : transportada por >

plan "1" -- "0..*" exec_order : genera >
exec_order "1" -- "1..*" transport_order_sale : requiere >
exec_order "1" -- "1..*"  transp_ord_hist : registra >
transport_order_sale "1" -- "1..*" transport_order_sale_item : contiene >
exec_order "1" -- "0..*" inventory : establece stock >

' =========================================================
' RELACIONES INTERNAS DE ÚLTIMA MILLA
' =========================================================

delivery "1" -- "1..*" delivery_item : "descarga productos en" >
delivery "1" -- "0..1" pod : "genera comprobante" >
delivery "1" -- "0..*" incident : "reporta problemas en" >
delivery "1" -- "0..*" delivery_history : "registra trazabilidad de" >

' =========================================================
' RELACIONES CON OTROS PAQUETES (CONEXIÓN DEL DIAGRAMA)
' =========================================================

' Conexión con Carga en Camión (Transport Orders)
exec_order "1" -- "1..*" delivery : "genera paradas físicas" >

' Conexión con Despachos / Planificación (Punto de Entrega Unificado)
plan_order "1" -- "0..*" delivery : "asociado a punto de entrega" >

' Conexión con Datos Externos / Catálogo (Productos)
snap_product "1" .. "0..*" delivery_item : "refiere producto"
snap_product "1" .. "0..*" incident : "asociado a producto (opcional)"

' Conexión Lógica con Inventario de Camión
inventory ..> delivery_item : "descuenta stock al entregar"

@enduml